# Noor-e-Deen — Phase 4+ service configuration
# Copy to .env and fill in when activating each service.
# Phase 1 needs NONE of these; stubs are wired in.

# --- Auth: choose ONE provider (see lib/core/services/auth/auth_service.dart) ---
# Option A: Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Option B: Firebase (also needs google-services.json / GoogleService-Info.plist)
# (no env vars; configure via Firebase console + native files)

# --- Google Sign-In (Android client id from Google Cloud console) ---
GOOGLE_CLIENT_ID=

# --- Notifications (Phase 4; no env needed) ---
# flutter_local_notifications + timezone packages
# Android: SCHEDULE_EXACT_ALARM permission; Adhan audio asset in assets/audio/

# --- Cloud sync uses the same backend as auth ---
# Supabase table `user_sync` or Firestore collection `users/{uid}`
